#!/usr/bin/env bash
# Configures /etc/hosts: localhost -> 127.0.0.2 and facebook.com -> 8.8.8.8
new_hosts=$(mktemp)
sed -e 's/^127\.0\.0\.1[[:space:]]\{1,\}localhost/127.0.0.2 localhost/' \
    -e '/[[:space:]]facebook\.com/d' /etc/hosts > "$new_hosts"
echo "8.8.8.8 facebook.com" >> "$new_hosts"
cp -f "$new_hosts" /etc/hosts
rm -f "$new_hosts"
